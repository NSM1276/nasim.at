---
// Inline SVG icons. Kept in the repo rather than pulled from a package so the
// page ships no extra JavaScript and no external request.
export type IconName =
  | 'gauge'
  | 'calendar'
  | 'target'
  | 'plug'
  | 'pencil'
  | 'smartphone'
  | 'video-off'
  | 'eye-off'
  | 'lock'
  | 'clock'
  | 'trend'
  | 'sparkles'
  | 'utensils'
  | 'wine'
  | 'bed'
  | 'bag'
  | 'check'
  | 'whatsapp'
  | 'phone'
  | 'mail';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;

const paths: Record<IconName, string> = {
  gauge: '<path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"/><path d="m13.4 10.6 4.1-4.1"/><path d="M21 12a9 9 0 1 0-18 0"/>',
  calendar:
    '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/>',
  target:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.2"/>',
  plug: '<path d="M9 2v6M15 2v6"/><path d="M6 8h12v3a6 6 0 0 1-12 0V8Z"/><path d="M12 17v5"/>',
  pencil:
    '<path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16v4Z"/><path d="m14.5 5.5 4 4"/>',
  smartphone:
    '<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18.5h2"/>',
  'video-off':
    '<path d="M11 5h5a2 2 0 0 1 2 2v3l4-2.5v9L18 14"/><path d="M14 19H4a2 2 0 0 1-2-2V7"/><path d="m2 2 20 20"/>',
  'eye-off':
    '<path d="M10.7 5.1A10.9 10.9 0 0 1 12 5c5 0 9 4.5 10 7a17 17 0 0 1-3 4"/><path d="M6.3 6.4C3.8 8 2.4 10.2 2 12c1 2.5 5 7 10 7a10 10 0 0 0 4.3-1"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/><path d="m2 2 20 20"/>',
  lock: '<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  trend: '<path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/>',
  sparkles:
    '<path d="M12 3l1.8 4.7L18.5 9.5 13.8 11.3 12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3Z"/><path d="M18.5 15.5 19.5 18l2.5 1-2.5 1-1 2.5-1-2.5L15 19l2.5-1 1-2.5Z"/>',
  utensils:
    '<path d="M4 3v7a3 3 0 0 0 6 0V3"/><path d="M7 10v11"/><path d="M17 3c-1.7 1-2.5 3-2.5 5.5 0 2 .8 3.2 2.5 3.5V21"/>',
  wine: '<path d="M8 3h8l-.8 6a3.2 3.2 0 0 1-6.4 0L8 3Z"/><path d="M12 14v7"/><path d="M8.5 21h7"/>',
  bed: '<path d="M3 20V7"/><path d="M3 12h18v8"/><path d="M7 12V9h6a3 3 0 0 1 3 3"/>',
  bag: '<path d="M6 8h12l1 13H5L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
  check: '<path d="m5 13 4 4L19 7"/>',
  whatsapp:
    '<path d="M3 21l1.6-4.6A8.4 8.4 0 1 1 8 20l-5 1Z"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1-.4 1-1v-.6l-1.8-.8-.9 1a5.6 5.6 0 0 1-2.4-2.4l1-.9-.8-1.8H10c-.6 0-1 .4-1 1Z"/>',
  phone:
    '<path d="M5 3h3.5l1.8 4.3-2.2 1.5a12.5 12.5 0 0 0 5.9 5.9l1.5-2.2L20 14.5V18a3 3 0 0 1-3.3 3A16.5 16.5 0 0 1 3 6.3 3 3 0 0 1 5 3Z"/>',
  mail: '<rect x="2.5" y="5" width="19" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
